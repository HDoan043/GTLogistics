# ==============================================================================
# GT LOGISTICS - CẤU HÌNH MÔI TRƯỜNG MẪU (.env.example)
# Hãy sao chép file này thành .env và điền các thông số thực tế của bạn
# ==============================================================================

# 1. Cơ sở dữ liệu PostgreSQL (Neon Cloud hoặc VPS tự host)
DATABASE_URL="postgresql://username:password@ep-host.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# 2. Khóa bí mật JWT xác thực phiên quản trị (Tạo chuỗi ngẫu nhiên 32 ký tự trở lên)
JWT_SECRET="generate-a-secure-random-32-char-key-for-production"

# 3. Tài khoản Admin khởi tạo lần đầu (khi chạy npm run db:seed)
ADMIN_DEFAULT_EMAIL="admin@logisticsgt.vn"
ADMIN_DEFAULT_PASSWORD="YourSecureAdminPassword123!"
ADMIN_DEFAULT_NAME="Quản Trị Viên GT"

# 4. Cấu hình thông tin thương hiệu công khai
NEXT_PUBLIC_SITE_URL="https://yourdomain.com"
NEXT_PUBLIC_COMPANY_NAME="CÔNG TY TNHH LOGISTICS GT"
NEXT_PUBLIC_HOTLINE="0904.382.268"
NEXT_PUBLIC_ZALO_PHONE="0904382268"
NEXT_PUBLIC_EMAIL="contact@logisticsgt.vn"
